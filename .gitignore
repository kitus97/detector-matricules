# --- Python & uv ---
.venv/
*venv/
__pycache__/
*.py[cod]
*$py.class
.python-version
uv.lock

# --- Dades i Pesos (IMPORTANT) ---
# No pugem el dataset sencer si és molt gran
data/
!data/.gitkeep
# Si guardeu models entrenats (p.ex. el fitxer del k-NN o SVM)
models/*.pkl
models/*.joblib

# --- Resultats i Proves ---
# Carpeta on guardareu els ROIs segmentats o les matrícules detectades
output/
temp/
*.log
models/

# --- Memòria tècnica ---
# El projecte LaTeX es treballa a Overleaf; al repositori només hi ha el PDF
# final entregat (docs/Memoria_MarcRams.pdf).
memoria/

# --- Artefactes de compilació LaTeX ---
*.aux
*.bbl
*.bcf
*.bcf-SAVE-ERROR
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex.gz
*.toc

# --- Eines d'assistència (configuració local, no forma part de l'entrega) ---
CLAUDE.md
.claude/

# --- OS & IDE ---
.DS_Store
.vscode/
.idea/
.ipynb_checkpoints/
